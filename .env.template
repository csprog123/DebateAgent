# Copy this file to .env and fill in your keys. Never commit .env.

# Required: OpenRouter API key. Get one at https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Optional: override the model slug. Default: anthropic/claude-sonnet-4.5
# Any OpenRouter-supported model works (e.g. openai/gpt-4o, google/gemini-pro-1.5).
MODEL_ID=

# Optional: attribution headers shown on OpenRouter's leaderboard.
OPENROUTER_REFERER=
OPENROUTER_APP_TITLE=

# Optional: required only if you use --notion-page or --notion-output.
NOTION_API_KEY=
