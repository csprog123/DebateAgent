{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/index.py": {
      "maxDuration": 300
    }
  },
  "rewrites": [
    { "source": "/", "destination": "/api/index" },
    { "source": "/api/debate", "destination": "/api/index" },
    { "source": "/api/health", "destination": "/api/index" }
  ]
}
